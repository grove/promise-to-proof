---
options:
  max_actions: 64
  max_concurrent_actions: 1
deadlock_detection: false
---
# Runner substitutes these constants in a scratch copy, never in this file.
SCENARIO = "repair"
MUTATION = "none"
WITNESS = "none"

# Artifact states: absent, volatile, saved, read back, lost, inaccessible.
# Exact identities are small integers; revision deliberately remains v1.
action Init:
    contract = 0
    revision = "v1"
    candidate = 0
    base = 0
    implemented = False
    stages = [0, 0] # not launched, running, returned
    bindings = [[], []] # contract, candidate, base, invocation
    reports = [0, 0]
    evidence = [0, 0]
    passed = [False, False]
    repair_used = 0 # durable accounting used by the scheduler
    repairs_actual = 0 # independent history, never reset by resume
    restarted = False
    fault = False
    outcome = "running"

atomic action Implement:
    require not implemented and outcome == "running"
    implemented = True

atomic action Launch:
    require implemented and outcome == "running"
    oneof stage in range(2):
        require stages[stage] == 0
        stages[stage] = 1
        # Stage 0 = independent read-only review, stage 1 = proof.
        bindings[stage] = [contract, candidate, base, 1 + stage + 2 * candidate]

atomic action Return:
    require outcome == "running"
    oneof stage in range(2):
        require stages[stage] == 1
        stages[stage] = 2
        reports[stage] = 1
        evidence[stage] = 1
        passed[stage] = not (stage == 1 and (SCENARIO == "exhausted" or (SCENARIO == "repair" and repairs_actual == 0)))
        if SCENARIO == "identity" and stage == 1:
            bindings[stage][0] = 2 # an old, mismatched report arrives
            fault = True

atomic action Save:
    require outcome == "running"
    oneof stage in range(2):
        oneof kind in ["report", "evidence"]:
            if kind == "report":
                require reports[stage] == 1
                reports[stage] = 2
            else:
                require evidence[stage] == 1
                evidence[stage] = 2

atomic action ReadBack:
    require outcome == "running"
    oneof stage in range(2):
        oneof kind in ["report", "evidence"]:
            if kind == "report":
                require reports[stage] == 2
                reports[stage] = 3
            else:
                require evidence[stage] == 2
                evidence[stage] = 3

atomic action Environment:
    require implemented and outcome == "running" and not fault
    require SCENARIO in ["text", "candidate", "base", "report-lost", "report-access", "evidence-lost", "evidence-access"]
    # Can race either running verifier, persistence, readback, or finalization.
    if SCENARIO == "text":
        contract = 1
    elif SCENARIO == "candidate":
        candidate = 1
    elif SCENARIO == "base":
        base = 1
    else:
        oneof stage in range(2):
            if SCENARIO in ["report-lost", "report-access"]:
                require reports[stage] == 3
                reports[stage] = 4 if SCENARIO == "report-lost" else 5
            else:
                require evidence[stage] == 3
                evidence[stage] = 4 if SCENARIO == "evidence-lost" else 5
    fault = True

atomic action Repair:
    require outcome == "running" and stages == [2, 2] and not all(passed)
    require repair_used < 1
    repair_used += 1
    repairs_actual += 1
    candidate += 1
    stages = [0, 0]
    reports = [0, 0]
    evidence = [0, 0]
    passed = [False, False]
    bindings = [[], []]

atomic action Restart:
    require outcome == "running" and not restarted
    # Model a restart of this invocation, not a new authorized invocation.
    restarted = True
    if MUTATION == "repair-reset":
        repair_used = 0
    for stage in range(2):
        if reports[stage] < 2:
            stages[stage] = 0
            bindings[stage] = []
            passed[stage] = False
            reports[stage] = 0
            evidence[stage] = 0
        else:
            if reports[stage] == 3:
                reports[stage] = 2
            if evidence[stage] == 1:
                evidence[stage] = 0
            elif evidence[stage] == 3:
                evidence[stage] = 2

atomic action Complete:
    require implemented and outcome == "running"
    # Operational decision: mutations remove ONE named check, not assertions.
    if stages != [2, 2]:
        outcome = "missing-stage"
    elif not all(passed):
        if repair_used == 1:
            outcome = "repair-exhausted"
        else:
            outcome = "failed-verification"
    elif MUTATION != "identity" and (bindings[0][0] != bindings[1][0] or bindings[0][1] != bindings[1][1]):
        outcome = "identity"
    elif MUTATION != "text" and bindings[0][0] != contract:
        outcome = "text"
    elif MUTATION != "candidate" and bindings[0][1] != candidate:
        outcome = "candidate"
    elif MUTATION != "base" and bindings[0][2] != base:
        outcome = "base"
    else:
        outcome = "complete"
        for stage in range(2):
            if reports[stage] == 0 and MUTATION != "report-absent":
                outcome = "report-absent"
            elif reports[stage] == 1 and MUTATION != "report-save":
                outcome = "report-save"
            elif reports[stage] == 2 and MUTATION != "report-read":
                outcome = "report-read"
            elif reports[stage] == 4 and MUTATION != "report-lost":
                outcome = "report-lost"
            elif reports[stage] == 5 and MUTATION != "report-access":
                outcome = "report-access"
            if evidence[stage] == 0 and MUTATION != "evidence-absent":
                outcome = "evidence-absent"
            elif evidence[stage] == 1 and MUTATION != "evidence-save":
                outcome = "evidence-save"
            elif evidence[stage] == 2 and MUTATION != "evidence-read":
                outcome = "evidence-read"
            elif evidence[stage] == 4 and MUTATION != "evidence-lost":
                outcome = "evidence-lost"
            elif evidence[stage] == 5 and MUTATION != "evidence-access":
                outcome = "evidence-access"

# Oracles remain intact for all mutations. Claim-time facts are frozen at terminal.
always assertion SameReports:
    return outcome != "complete" or (bindings[0][0:2] == bindings[1][0:2])
always assertion CurrentText:
    return outcome != "complete" or all([b[0] == contract for b in bindings])
always assertion CurrentCandidate:
    return outcome != "complete" or all([b[1] == candidate for b in bindings])
always assertion ComparisonBase:
    return outcome != "complete" or bindings[0][2] == base
always assertion DurableReports:
    return outcome != "complete" or reports == [3, 3]
always assertion DurableEvidence:
    return outcome != "complete" or evidence == [3, 3]
always assertion IndependentFullStages:
    return outcome != "complete" or (stages == [2, 2] and all(passed) and bindings[0][3] != bindings[1][3])
always assertion RepairBound:
    return repairs_actual <= 1
# Negated reachability query: expected failure retains a concrete witness.
always assertion Witness:
    if WITNESS == "initial":
        return not (outcome == "complete" and repairs_actual == 0 and not restarted)
    if WITNESS == "repair":
        return not (outcome == "complete" and repairs_actual == 1 and bindings[0][1] == 1 and bindings[1][1] == 1)
    if WITNESS == "restart":
        return not (outcome == "complete" and restarted and repairs_actual == 1)
    if WITNESS == "exhausted":
        return not (outcome == "repair-exhausted" and restarted and repairs_actual == 1)
    if WITNESS == "text":
        return not (outcome == "text" and fault and revision == "v1")
    if WITNESS != "none":
        return outcome != WITNESS
    return True
